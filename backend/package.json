{
  "name": "backend",
  "private": "true",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env APP_MODE=development tsx watch src/index.ts",
    "dev-phone": "cross-env APP_MODE=phone tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "cross-env NODE_ENV=production APP_MODE=production node dist/index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
